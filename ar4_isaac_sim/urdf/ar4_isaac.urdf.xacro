<?xml version="1.0"?>
<robot name="ar4" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- base model -->
  <xacro:include filename="$(find ar4_description)/urdf/ar4.urdf.xacro" />.

  <!-- ros2_control extensions -->
  <xacro:include filename="$(find ar4_isaac_sim)/urdf/ar4.ros2_control.xacro" />

  <link name="world" />

  <joint name="joint_world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

</robot>
