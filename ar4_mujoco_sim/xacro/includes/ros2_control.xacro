<?xml version="1.0"?>
<robot name="ar4" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="headless" default="false" />

  <!-- The MJCF model drives the joints with torque motors; mujoco_ros2_control closes the
       position loop with the PID gains in config/mujoco_pid.yaml. -->
  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find ar4_mujoco_sim)/mjcf/scene.xml</param>
      <param name="pids_config_file">$(find ar4_mujoco_sim)/config/mujoco_pid.yaml</param>
      <param name="headless">$(arg headless)</param>
      <param name="auto_register_cameras">false</param>
    </hardware>

    <xacro:macro name="mujoco_joint" params="name">
      <joint name="${name}">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
    </xacro:macro>

    <xacro:mujoco_joint name="joint_1" />
    <xacro:mujoco_joint name="joint_2" />
    <xacro:mujoco_joint name="joint_3" />
    <xacro:mujoco_joint name="joint_4" />
    <xacro:mujoco_joint name="joint_5" />
    <xacro:mujoco_joint name="joint_6" />
  </ros2_control>

</robot>
