# Physics overrides (as in Kairos' AR4): the imported drives had no damping and allowed 3000 Nm, so the arm
# overshot its targets and contacts blew up the solver (non-finite transforms). Joint speeds are capped at the
# URDF limits (0.5 rad/s on J1-J4, 1.0 rad/s on J5-J6; the import set 5000 deg/s). Adjacent link meshes
# overlap at many poses, so self-collision is off.
over "ar4"
{
    bool physxArticulation:enabledSelfCollisions = 0
    int physxArticulation:solverPositionIterationCount = 32
    int physxArticulation:solverVelocityIterationCount = 4

    over "base_link"
    {
        over "joint_1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 100000
            float drive:angular:physics:maxForce = 50
            float physxJoint:maxJointVelocity = 28.6479
        }
    }

    over "link_1"
    {
        over "joint_2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 100000
            float drive:angular:physics:maxForce = 50
            float physxJoint:maxJointVelocity = 28.6479
        }
    }

    over "link_2"
    {
        over "joint_3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 100000
            float drive:angular:physics:maxForce = 50
            float physxJoint:maxJointVelocity = 28.6479
        }
    }

    over "link_3"
    {
        over "joint_4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 100000
            float drive:angular:physics:maxForce = 15
            float physxJoint:maxJointVelocity = 28.6479
        }
    }

    over "link_4"
    {
        over "joint_5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 100000
            float drive:angular:physics:maxForce = 15
            float physxJoint:maxJointVelocity = 57.2958
        }
    }

    over "link_5"
    {
        over "joint_6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 100000
            float drive:angular:physics:maxForce = 15
            float physxJoint:maxJointVelocity = 57.2958
        }
    }

    over "link_6"
    {
    }

    over "gripper_base_link"
    {
        over "finger_joint_1"
        {
            float drive:linear:physics:damping = 10000
            float drive:linear:physics:stiffness = 1000000
            float drive:linear:physics:maxForce = 30
        }
    }
}

