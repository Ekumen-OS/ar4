    def Scope "Looks"
    {
        def Material "material_black"
        {
            token outputs:mdl:displacement.connect = </ar4/Looks/material_black/Shader.outputs:out>
            token outputs:mdl:surface.connect = </ar4/Looks/material_black/Shader.outputs:out>
            token outputs:mdl:volume.connect = </ar4/Looks/material_black/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0, 0, 0)
                token outputs:out
            }
        }

